# Copy to .env with `pnpm env:local`. In Kubernetes variables come from the ConfigMap
# <svc>-config and the SealedSecret <svc>-secrets (envFrom), not from a file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_VERSION=dev
# Port of the separate Prometheus listener (GET /metrics); 0 turns it off.
METRICS_PORT=9464
# Proxy hops in front of the service (0 locally, 1 behind one ingress); used for client IPs.
TRUST_PROXY_HOPS=0
# Delay before shutdown after SIGTERM so the load balancer drops the pod first (ms).
# 0 in Kubernetes: the pod's preStop sleep does that.
SHUTDOWN_DELAY_MS=0

# Secrets: no defaults in code. Values below match compose.yaml and are for local use only.
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_POOL_MAX=10

# Model catalog; empty: config/models.json of this app.
LLM_MODELS_PATH=
# Clients: JSON list of {name, keySha256, models, admin}. `node scripts/client-key.mjs <name>`
# prints a key (for the client's secrets) and the entry (the hash is not a secret).
LLM_CLIENTS=[]
# The one logged-in account per provider.
LLM_ACCOUNT=owner
# Codex CLI and its login (codex login --device-auth with this CODEX_HOME). Empty: ~/.codex.
CODEX_COMMAND=codex
CODEX_HOME=
# Claude Code CLI and the subscription token (claude setup-token). Empty: Claude models unavailable.
CLAUDE_COMMAND=claude
CLAUDE_CODE_OAUTH_TOKEN=
# MiniMax API key. Empty: MiniMax models unavailable.
MINIMAX_API_KEY=
# Pause after a usage limit whose reset time the provider did not name (seconds).
LLM_QUOTA_PAUSE_SECONDS=3600
# Longest wait for a free provider slot before 503 (ms).
LLM_QUEUE_TIMEOUT_MS=900000
# Calls and finished jobs older than this are deleted, texts included.
LLM_LOG_RETENTION_DAYS=14
# Jobs running at once.
LLM_JOB_CONCURRENCY=4
